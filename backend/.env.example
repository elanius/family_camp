# MongoDB (same Atlas cluster as the kids camp, different database)
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
MONGODB_DB=evs-vzdelavanie-2026

# Base URL of the deployed frontend – used to build "edit your registration" links
APP_BASE_URL=http://localhost:5173

# Email (set to false to disable all outgoing emails, e.g. during development)
EMAIL_ENABLED=true

# SMTP
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_USER=vzdelavanie@evs.sk
SMTP_PASSWORD=your_password_here

# Bank details used for the payment-info email and the Pay by Square QR code
BANK_IBAN=SK0000000000000000000000
BANK_NAME="Názov banky"
BANK_BENEFICIARY="Vzdelávanie EVS"

# Admin auth
JWT_SECRET=change_me
